@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="text-center">
  <script src="/js/go.js"></script>
  <script src="/js/person.js"></script>
  <script src="/js/flowchart.js"></script>
  <script src="/js/sequence.js"></script>
  <script id="code">
    
    // Show the diagram's model in JSON format that the user may edit
    function save() {
      document.getElementById("workflowModel").value = d_flow.model.toJson();
      d_flow.isModified = false;
    }
    function load() {
      fetch(`/api/workflow/${$('#SelectedWorkflow').val()}`)
        .then(function (response) {
          $('#workflowModel').text(response);
          return response.json();
        })
        .then(function (json) {
          window.wjson = json;
          if (window.last_workflow != json.id) {
            window.last_workflow = json.id;
            d_flow.model = go.Model.fromJson(json.contents);
          }
        });
          //d_flow.model = go.Model.fromJson(document.getElementById("mySavedModel").value);
    }

    // Show the diagram's model in JSON format
    function save_sequence() {
      document.getElementById("sequenceModel").value = window.d_sequence.model.toJson();
      window.d_sequence.isModified = false;
    }
    function load_sequence() {
      window.d_sequence.model = go.Model.fromJson(document.getElementById("sequenceModel").value);
    }
    // Call init on page load
    window.addEventListener('DOMContentLoaded', () => init_person('divPerson', '/api/person/'));
    window.addEventListener('DOMContentLoaded', () => window.d_flow = init_flowchart('divFlowchart', 'divPalette', load));
    window.addEventListener('DOMContentLoaded', () => { window.d_sequence = init_sequence('divSequence', load_sequence); load_sequence(); });
    window.addEventListener('DOMContentLoaded', () => $('#SelectedWorkflow').click(load));
  </script>
