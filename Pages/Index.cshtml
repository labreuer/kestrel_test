@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="text-center">
  <script type="module" id="code">
    import { init } from '/js/minimal.js';
    window.addEventListener('DOMContentLoaded', init);
  </script>

  <select asp-for="SelectedWorkflow" asp-items="Model.WorkflowsSelect"></select>
  <button id="saveWorkflow">Save Workflow</button>
  <button id="newWorkflow">New Workflow</button>
  <input id="workflowTitle" type="text" />
  <div style="width: 100%; display: flex; justify-content: space-between">
    <div id="divPalette" style="width: 100px; margin-right: 2px; background-color: #282c34;"></div>
    <div id="divWorkflow" style="flex-grow: 1; height: 750px; background-color: #282c34;"></div>
  </div>
  <select id="SelectedWorkflow2"></select>
  <button id="saveWorkflow2">Save Child Workflow</button>
  <button id="newWorkflow2">New Child Workflow</button>
  <input id="workflowTitle2" type="text" />
  <div style="width: 100%; display: flex; justify-content: space-between">
    <div id="divPalette2" style="width: 100px; margin-right: 2px; background-color: #282c34;"></div>
    <div id="divWorkflow2" style="flex-grow: 1; height: 350px; background-color: #282c34;"></div>
  </div>
</div>
